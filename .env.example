# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, email verification links, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection URI (e.g. Neon serverless PostgreSQL).
# If omitted, application falls back to data/db.json persistent local file storage.
DATABASE_URL=""

# SESSION_SIGNING_SECRET: 256-bit cryptographic HMAC key used for signing completed sessions.
# For multi-server production deployment, this MUST be set in host environment variables.
# If omitted during local testing, a stable fallback key is automatically persisted in data/.session_signing_secret.
SESSION_SIGNING_SECRET=""

# REQUIRE_EMAIL_VERIFICATION: Set to "true" to mandate that users confirm email before matching.
# Set to "false" to permit instant matching without email verification.
REQUIRE_EMAIL_VERIFICATION="true"

# SMTP Configuration for sending email verification codes and password reset links:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="Someone <no-reply@someone.local>"

# Initial Administrator Provisioning (Optional bootstrap credentials on startup):
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_DISPLAY_NAME="Administrator"
ADMIN_BOOTSTRAP_KEY=""

# Web Push Notification VAPID Credentials (Optional - auto-generated and persisted in data/vapid.json if omitted):
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@someone.chat"

